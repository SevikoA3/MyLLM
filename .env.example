# Tidak ada variabel lingkungan yang dibutuhkan pada Phase 0.
# Jangan menaruh API key di sini. Credential disimpan lewat expo-secure-store pada Phase 2.

# Opsional, hanya untuk smoke test dari terminal (npm run smoke:models).
# Aplikasi Android tidak membaca nilai ini; credential di device selalu lewat expo-secure-store.
# Jangan commit file .env yang berisi key asli.
# AMANAI_ENDPOINT=https://api.amanai.dev/v1
# AMANAI_KEY=
